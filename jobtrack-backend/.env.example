# Direct connection (IPv6) — fine for local dev on IPv6-capable networks only.
# SUPABASE_DB_URL=jdbc:postgresql://db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres

# Supavisor pooler (IPv4) — required for Render and most cloud hosts. Copy the Session
# pooler host from Supabase Dashboard → Connect → Session mode, then use JDBC form:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-YOUR-AWS-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=your-database-password-here
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here
HIBERNATE_DDL_AUTO=none
