# Copy to .env and fill in values from the Supabase dashboard.
# See docs/SUPABASE_SETUP.md for step-by-step instructions.

# JDBC URL — use direct connection (port 5432) with sslmode=require
# Example: jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=

# Database user (usually "postgres")
SUPABASE_DB_USER=postgres

# Database password set when the Supabase project was created
SUPABASE_DB_PASSWORD=

# Settings → API → JWT Secret (used in Phase 2 for token validation)
SUPABASE_JWT_SECRET=

# Used to control Hibernate schema management.
# - During early setup (no migrations yet): set to "none"
# - After migrations exist: you can switch to "validate"
HIBERNATE_DDL_AUTO=none

# Optional — Render sets PORT automatically in production
# PORT=8080
